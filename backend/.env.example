# Copy to backend/.env and fill in. Never commit real values.
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Expose /api/demo/snapshot and /api/demo/reset when NODE_ENV=production (e.g. on Vercel).
# Note: on serverless the in-memory demo store is per instance and resets on cold starts.
ENABLE_DEMO_ROUTES=false

# Integration modes: "mock" (default) or "live".
# Live adapters are NOT implemented yet — selecting "live" fails fast at startup.
PAYMENTS_PROVIDER=mock
MEETINGS_PROVIDER=mock
NOTIFICATIONS_PROVIDER=mock
SPEECH_PROVIDER=mock

# Paystack (server-side only)
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=

# Google Calendar API (Google Meet links)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_WORKSPACE_DOMAIN=
GOOGLE_MEET_ORGANIZER_EMAIL=

# Email & WhatsApp
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
WHATSAPP_PROVIDER_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Speech / conversational AI
SPEECH_AI_API_KEY=

# Persistence (not yet used — demo data lives in memory)
DATABASE_URL=
