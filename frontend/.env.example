# Copy to frontend/.env.local if needed. Only public, non-secret values belong here.
# Base URL of the backend API. With the Vite dev proxy, "/api" works out of the box.
VITE_API_URL=/api
# "auto" (default): use the API when reachable, otherwise the built-in demo adapter.
# "demo": never call the API — fully offline demo.
VITE_DATA_MODE=auto
